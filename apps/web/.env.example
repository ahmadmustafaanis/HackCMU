# Same Google OAuth Client ID as apps/api/.env's GOOGLE_CLIENT_ID (this is
# the public Client ID, not the secret — safe to embed in frontend code).
# See apps/api/.env.example for how to create one.
# Without this set, the Welcome/Login screens fall back to "Continue as
# Guest" only — the app still works, just without real Google sign-in.
VITE_GOOGLE_CLIENT_ID=
