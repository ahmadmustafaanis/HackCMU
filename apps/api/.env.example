# Leave unset to use an in-process mongodb-memory-server (default, zero setup).
# Set to a real connection string (e.g. MongoDB Atlas) to use a persistent DB instead.
MONGODB_URI=

# Required for real Gemini semantic-parsing calls. Without it, SemanticParser
# still works for structured/synonym/cached input — only novel free text
# needing an actual LLM call will fail gracefully (see withFallback).
# GEMINI_API_KEY is accepted as an alias for GOOGLE_API_KEY.
# This file can live here (apps/api/.env) or at the repo root — both are
# loaded (server.ts), with apps/api/.env taking precedence if both set the
# same variable.
GOOGLE_API_KEY=

# Optional override, defaults to gemini-3.6-flash.
GEMINI_MODEL_ID=

# --- Sign in with Google ---
# Required for POST /api/auth/google to work. Create one at
# https://console.cloud.google.com/apis/credentials → "Create Credentials" →
# "OAuth client ID" → Application type "Web application" → add
# http://localhost:5173 under "Authorized JavaScript origins" (no path/port
# suffix needed beyond 5173). Copy the Client ID (NOT the client secret — the
# ID-token flow used here never needs it) here AND into
# apps/web/.env as VITE_GOOGLE_CLIENT_ID (same value, both places).
GOOGLE_CLIENT_ID=

# Required in any real deployment — signs session tokens. Generate one with
# `openssl rand -hex 32`. If unset, a hardcoded insecure development fallback
# is used (with a console warning) so local dev still works without it.
SESSION_JWT_SECRET=

PORT=4000
