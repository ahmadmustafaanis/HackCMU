# Leave unset to use an in-process mongodb-memory-server (default, zero setup).
# Set to a real connection string (e.g. MongoDB Atlas) to use a persistent DB instead.
MONGODB_URI=

# Required for real Gemini semantic-parsing calls. Without it, SemanticParser
# still works for structured/synonym/cached input — only novel free text
# needing an actual LLM call will fail gracefully (see withFallback).
# GEMINI_API_KEY is accepted as an alias for GOOGLE_API_KEY.
# This file can live here (apps/api/.env) or at the repo root — both are
# loaded (server.ts), with apps/api/.env taking precedence if both set the
# same variable.
GOOGLE_API_KEY=

# Optional override, defaults to gemini-2.5-flash.
GEMINI_MODEL_ID=

PORT=4000
